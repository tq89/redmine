<%
  # One row of the step table. Shared by the rendered rows and by the template
  # the "add step" button clones, so both always carry the same fields.
  sf = local_assigns[:sf]
%>
<tr>
  <td><%= sf.number_field :position, :size => 3, :min => 0 %></td>
  <td><%= sf.text_field :name, :size => 30 %></td>
  <% if @route.extension? %>
    <%= sf.hidden_field :issue_status_id, :value => '' %>
  <% else %>
    <td>
      <%= sf.select :issue_status_id,
                    [[l(:label_none), '']] + IssueStatus.sorted.map {|s| [s.name, s.id]} %>
    </td>
  <% end %>
  <td>
    <%= sf.select :approver_token,
                  grouped_options_for_select(approval_approver_options(@project),
                                             sf.object.approver_token),
                  {:include_blank => l(:label_approver_anyone)},
                  :class => 'approver-token' %>
  </td>
  <td><%= sf.text_field :button_label, :size => 16,
                        :placeholder => l(:button_approve) %></td>
  <td><%= sf.check_box :_destroy unless sf.object.new_record? %></td>
</tr>
