<%
  # One row of the step table. Shared by the rendered rows and by the template
  # the "add step" button clones, so both always carry the same fields.
  sf = local_assigns[:sf]
%>
<tr class="approval-step-row">
  <td><%= sf.number_field :position, :size => 3, :min => 0 %></td>
  <td><%= sf.text_field :name, :size => 24 %></td>
  <% if @route.extension? %>
    <%= sf.hidden_field :issue_status_id, :value => '' %>
  <% else %>
    <td>
      <%= sf.select :issue_status_id,
                    [[l(:label_none), '']] + IssueStatus.sorted.map {|s| [s.name, s.id]} %>
    </td>
  <% end %>
  <td class="approval-step-approvers">
    <%= render :partial => 'approval_routes/chip_picker',
               :locals => {:name => "#{sf.object_name}[approver_tokens][]",
                           :choices => approval_approver_options(@project),
                           :selected => sf.object.approver_tokens} %>
  </td>
  <td>
    <%= sf.select :approval_mode,
                  [[l(:label_approval_mode_any), ApprovalRouteStep::ANY_MODE],
                   [l(:label_approval_mode_all), ApprovalRouteStep::ALL_MODE]],
                  {}, :class => 'approval-mode' %>
  </td>
  <td><%= sf.text_field :button_label, :size => 14,
                        :placeholder => l(:button_approve) %></td>
  <% if @route.extension? %>
    <%= sf.hidden_field :assign_signer, :value => '0' %>
    <%= sf.hidden_field :assign_author, :value => '0' %>
  <% else %>
    <td class="approval-step-assign">
      <label><%= sf.check_box :assign_signer %> <%= l(:label_assign_signer) %></label>
      <label><%= sf.check_box :assign_author %> <%= l(:label_assign_author) %></label>
    </td>
  <% end %>
  <td><%= sf.check_box :_destroy unless sf.object.new_record? %></td>
</tr>
