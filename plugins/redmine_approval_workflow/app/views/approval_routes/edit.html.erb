<h2><%= l(:label_approval_route) %>: <%= h @route.name %></h2>

<%= labelled_form_for @route, :url => approval_route_path(@route), :method => :put do |f| %>
  <%= render :partial => 'form', :locals => {:f => f} %>
  <p>
    <%= submit_tag l(:button_save) %>
    <%= link_to l(:button_cancel), approval_routes_path %>
  </p>
<% end %>
