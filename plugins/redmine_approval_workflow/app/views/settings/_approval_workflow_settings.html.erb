<div class="box tabular settings">
  <p>
    <label for="settings_max_extension_days"><%= l(:setting_max_extension_days) %></label>
    <%= number_field_tag 'settings[max_extension_days]', settings['max_extension_days'],
                         :min => 0, :size => 6, :id => 'settings_max_extension_days' %>
    <em class="info"><%= l(:text_max_extension_days_hint) %></em>
  </p>

  <p>
    <label for="settings_max_extension_count"><%= l(:setting_max_extension_count) %></label>
    <%= number_field_tag 'settings[max_extension_count]', settings['max_extension_count'],
                         :min => 0, :size => 6, :id => 'settings_max_extension_count' %>
    <em class="info"><%= l(:text_max_extension_count_hint) %></em>
  </p>

  <p>
    <label for="settings_require_extension_reason"><%= l(:setting_require_extension_reason) %></label>
    <%= hidden_field_tag 'settings[require_extension_reason]', '0', :id => nil %>
    <%= check_box_tag 'settings[require_extension_reason]', '1',
                      settings['require_extension_reason'].to_s == '1',
                      :id => 'settings_require_extension_reason' %>
  </p>

  <p>
    <label for="settings_show_pending_approvals"><%= l(:setting_show_pending_approvals) %></label>
    <%= hidden_field_tag 'settings[show_pending_approvals]', '0', :id => nil %>
    <%= check_box_tag 'settings[show_pending_approvals]', '1',
                      settings['show_pending_approvals'].to_s != '0',
                      :id => 'settings_show_pending_approvals' %>
    <em class="info"><%= l(:text_show_pending_approvals_hint) %></em>
  </p>

  <p>
    <label for="settings_notify_on_pending_approval"><%= l(:setting_notify_on_pending_approval) %></label>
    <%= hidden_field_tag 'settings[notify_on_pending_approval]', '0', :id => nil %>
    <%= check_box_tag 'settings[notify_on_pending_approval]', '1',
                      settings['notify_on_pending_approval'].to_s == '1',
                      :id => 'settings_notify_on_pending_approval' %>
    <em class="info"><%= l(:text_notify_on_pending_approval_hint) %></em>
  </p>

  <p>
    <label for="settings_sync_status_from_history"><%= l(:setting_sync_status_from_history) %></label>
    <%= hidden_field_tag 'settings[sync_status_from_history]', '0', :id => nil %>
    <%= check_box_tag 'settings[sync_status_from_history]', '1',
                      settings['sync_status_from_history'].to_s != '0',
                      :id => 'settings_sync_status_from_history' %>
    <em class="info"><%= l(:text_sync_status_from_history_hint) %></em>
  </p>
</div>

<p class="info"><%= l(:text_routes_moved_to_project_settings) %></p>
