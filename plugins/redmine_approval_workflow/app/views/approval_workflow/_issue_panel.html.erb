<%
  # Rendered through the view hook, so the locals are the hook context.
  issue = local_assigns[:issue]
  visible = issue.present? && issue.persisted?
  show_approval = visible && issue.approval_route? &&
                  User.current.allowed_to?(:view_approval_workflow, issue.project)
  show_extension = visible && (issue.issue_extensions.any? || issue.extendable_by?(User.current))
%>
<% if show_approval || show_extension %>
<%# One wrapper so both boxes travel together when the script below moves them. %>
<div id="approval-issue-panel">
<% if show_approval %>
  <div class="approval-workflow box">
    <h3><%= l(:label_approval_route) %>: <%= h issue.approval_route.name %></h3>

    <% if issue.approval_out_of_sync? %>
      <p class="warning"><%= l(:warning_approval_out_of_sync) %></p>
    <% end %>

    <ol class="approval-steps">
      <% issue.approval_route.steps.each do |step| %>
        <% state = approval_step_state(issue, step) %>
        <% signature = last_signature_for(issue, step) %>
        <li class="<%= approval_step_css(state) %>">
          <%= approval_step_icon(state) %>
          <span class="approval-step-name"><%= h step.name %></span>
          <span class="approval-step-status">&rarr; <%= h step.issue_status.name %></span>
          <% if (approver = approval_step_approver_label(step)) %>
            <span class="approval-assignee"><%= h approver %></span>
          <% end %>
          <% if step.assigns_signer? %>
            <span class="approval-assign-badge"
                  title="<%= l(:text_assign_signer_hint) %>"><%= l(:label_assign_signer) %></span>
          <% end %>
          <% if signature %>
            <span class="approval-step-signature <%= 'approval-derived' if signature.derived? %>">
              <%= link_to_user signature.user %>,
              <%= format_time signature.created_at %>
              <% if signature.derived? %>
                <span class="approval-derived-badge"
                      title="<%= l(:text_derived_signature_hint) %>"><%= l(:label_derived_from_history) %></span>
                <% if signature.journal_id %>
                  <%= link_to l(:label_view_history), issue_path(issue, :anchor => "change-#{signature.journal_id}") %>
                <% end %>
              <% end %>
              <% if signature.rejected? %>
                <span class="approval-rejected"><%= l(:label_approval_rejected) %></span>
              <% end %>
              <% if signature.comments.present? %>
                <div class="approval-step-comment"><%= textilizable signature.comments %></div>
              <% end %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ol>

    <p class="buttons">
      <% if issue.can_approve?(User.current) %>
        <%= link_to sprite_icon('checked', issue.approval_action_label),
                    new_issue_approval_path(issue, :decision => 'approve'),
                    :class => 'icon icon-checked button-positive' %>
      <% end %>
      <% if issue.can_reject_approval?(User.current) %>
        <%= link_to sprite_icon('cancel', l(:button_reject_approval)),
                    new_issue_approval_path(issue, :decision => 'reject'),
                    :class => 'icon icon-cancel' %>
      <% end %>
      <% if issue.approval_completed? %>
        <span class="approval-completed"><%= l(:label_approval_completed) %></span>
      <% end %>
      <% if User.current.allowed_to?(:sync_approval_history, issue.project) && !issue.approval_completed? %>
        <%= link_to l(:button_sync_from_history), sync_issue_approvals_path(issue),
                    :method => :post, :class => 'icon icon-reload',
                    :title => l(:text_sync_button_hint) %>
      <% end %>
    </p>
  </div>
<% end %>

<% if show_extension %>
  <div class="issue-extensions box">
    <h3><%= l(:label_issue_extension_plural) %></h3>

    <p>
      <strong><%= l(:field_due_date) %>:</strong>
      <%= issue.due_date ? format_date(issue.due_date) : l(:label_none) %>
      <span class="approval-hint">(<%= approval_max_extension_label %>)</span>
    </p>

    <% issue.issue_extensions.select(&:pending?).each do |extension| %>
      <div class="extension-request">
        <h4>
          <%= l(:label_extension_request) %>:
          <%= extension.previous_due_date ? format_date(extension.previous_due_date) : l(:label_none) %>
          &rarr; <strong><%= format_date extension.new_due_date %></strong>
          <span class="<%= extension_status_css(extension) %>"><%= extension_status_label(extension) %></span>
        </h4>
        <p class="extension-request-meta">
          <%= l(:label_extension_requested_by) %>: <%= link_to_user extension.user %>,
          <%= format_time extension.created_at %>
          <% if extension.reason.present? %>
            &middot; <%= l(:label_extension_reason) %>: <%= h extension.reason %>
          <% end %>
        </p>

        <%= render :partial => 'approval_workflow/extension_chain',
                   :locals => {:extension => extension} %>

        <p class="info"><%= l(:text_extension_pending_hint) %></p>

        <% if extension.signable_by?(User.current) %>
          <p class="buttons">
            <%= button_to extension.approval_action_label,
                          approve_issue_issue_extension_path(issue, extension),
                          :method => :post,
                          :class => 'button-positive',
                          :data => {:confirm => l(:text_confirm_extension_approve,
                                                  :date => format_date(extension.new_due_date))} %>
            <%= button_to l(:button_reject_extension),
                          reject_issue_issue_extension_path(issue, extension),
                          :method => :post,
                          :data => {:confirm => l(:text_are_you_sure)} %>
          </p>
        <% end %>
      </div>
    <% end %>

    <% if issue.issue_extensions.any? %>
      <table class="list issue-extension-list">
        <thead>
          <tr>
            <th><%= l(:label_date) %></th>
            <th><%= l(:label_user) %></th>
            <th><%= l(:label_extension_from_to) %></th>
            <th><%= l(:label_extension_days) %></th>
            <th><%= l(:field_status) %></th>
            <th><%= l(:field_comments) %></th>
          </tr>
        </thead>
        <tbody>
          <% issue.issue_extensions.each do |extension| %>
            <tr>
              <td><%= format_time extension.created_at %></td>
              <td><%= link_to_user extension.user %></td>
              <td>
                <%= extension.previous_due_date ? format_date(extension.previous_due_date) : l(:label_none) %>
                &rarr; <%= format_date extension.new_due_date %>
              </td>
              <td><%= extension.days %></td>
              <td><span class="<%= extension_status_css(extension) %>"><%= extension_status_label(extension) %></span></td>
              <td><%= h extension.reason %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <% if issue.extendable_by?(User.current) %>
      <p class="buttons">
        <%= link_to sprite_icon('time-add', l(:button_extend_due_date)),
                    new_issue_issue_extension_path(issue),
                    :class => 'icon icon-time-add' %>
      </p>
    <% end %>
  </div>
<% end %>
</div>

  <%# Scrolled past the panel, the step and its buttons follow the reader in
      Redmine's own floating header. Rendered here, hidden, then moved -- core
      offers no hook inside #sticky-issue-header, and patching the layout is
      exactly what this plugin exists without. %>
  <div id="approval-sticky-staging" hidden>
    <%= render :partial => 'approval_workflow/sticky_actions', :locals => {:issue => issue} %>
  </div>
  <script>
    (function () {
      // The panel is rendered after the whole page, which puts it below the
      // "other formats" line that closes issues/show.html.erb. That line is
      // inside the page content and the panel is rendered after it, so there
      // is no hook between the two -- the panel is lifted above it here.
      // Nothing found, nothing moved: it simply stays at the foot of the page.
      var panel = document.getElementById('approval-issue-panel');
      var formats = document.querySelector('#content p.other-formats');
      if (panel && formats && formats.parentNode) {
        formats.parentNode.insertBefore(panel, formats);
      }

      var staging = document.getElementById('approval-sticky-staging');
      if (!staging) { return; }

      var header = document.getElementById('sticky-issue-header');
      var block = staging.querySelector('.approval-sticky');
      // The header is parsed before this hook runs, so it is already there; a
      // Redmine that drops or renames it simply leaves the block unshown.
      if (header && block && !header.querySelector('.approval-sticky')) {
        header.appendChild(block);
      }
      staging.remove();
    })();
  </script>
<% end %>
