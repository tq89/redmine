<%
  # Rendered on Redmine's stock view_layouts_base_body_bottom hook, then moved
  # into place by the script below. Going through an existing hook is what keeps
  # this plugin free of core edits: a hook of our own in base.html.erb would mean
  # shipping a patched copy of the layout, which silently reverts whatever a
  # later Redmine adds to it.
  show_bell = User.current.logged? && RedmineApprovalWorkflow::PendingApprovals.enabled?
%>
<div id="approval-layout-additions" hidden>
  <% if show_bell %>
    <%= render :partial => 'approval_workflow/bell' %>
  <% end %>
  <span id="approval-footer-credit"><%= l(:text_operated_by) %></span>
</div>

<script>
  // Runs inline at the end of <body>, so both targets are already parsed and
  // the move happens before the browser paints them. Redmine sets no Content
  // Security Policy, so an inline script is served as-is.
  (function () {
    var root = document.documentElement;
    // A second copy of this script would otherwise append a second credit line.
    if (root.getAttribute('data-approval-relocated')) { return; }
    root.setAttribute('data-approval-relocated', '1');

    var source = document.getElementById('approval-layout-additions');
    if (!source) { return; }

    var bell = document.getElementById('approval-bell');
    var profileMenu = document.querySelector('.profile-menu');
    if (bell && profileMenu) {
      profileMenu.insertBefore(bell, profileMenu.firstChild);
      // nav.top-menu is a flex row, but .profile-menu itself carries no layout
      // in core, so its children stack: a block #account after the bell would
      // drop onto a second line and leave the avatar clipped out of the bar.
      // The class is added here rather than styling .profile-menu outright, so
      // nothing changes for anyone whose bell is switched off.
      profileMenu.classList.add('has-approval-bell');
    }

    var credit = document.getElementById('approval-footer-credit');
    var footer = document.getElementById('footer');
    // Skip when the footer already says this -- an older deployment that still
    // carries the patched core layout prints the same line itself, and two of
    // them is worse than none.
    if (credit && footer && footer.textContent.indexOf(credit.textContent.trim()) === -1) {
      footer.appendChild(document.createElement('br'));
      footer.appendChild(credit);
    }

    // Anything that found no home stays inside the hidden wrapper and is
    // dropped with it, rather than appearing loose at the foot of the page.
    source.remove();
  })();
</script>
