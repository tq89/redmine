<h2><%= l(:label_pending_approval_plural) %></h2>

<% if @issues.any? %>
  <% if @capped %>
    <p class="warning"><%= l(:warning_pending_approvals_capped,
                             :count => RedmineApprovalWorkflow::PendingApprovals::CANDIDATE_LIMIT) %></p>
  <% end %>

  <table class="list issues">
    <thead>
      <tr>
        <th>#</th>
        <th><%= l(:label_project) %></th>
        <th><%= l(:field_tracker) %></th>
        <th><%= l(:field_subject) %></th>
        <th><%= l(:field_status) %></th>
        <th><%= l(:label_approval_step) %></th>
        <th><%= l(:label_status_change) %></th>
        <th><%= l(:field_due_date) %></th>
      </tr>
    </thead>
    <tbody>
      <% @issues.each do |issue| %>
        <% step = issue.current_approval_step %>
        <tr class="issue">
          <td><%= link_to issue.id, issue_path(issue) %></td>
          <td><%= link_to_project issue.project %></td>
          <td><%= h issue.tracker.name %></td>
          <td><%= link_to issue.subject, issue_path(issue) %></td>
          <td><%= h issue.status.name %></td>
          <td>
            <%= h step&.name %>
            <span class="approval-button-label">[<%= h(step&.action_label) %>]</span>
          </td>
          <td><%= h issue.status.name %> &rarr; <strong><%= h step&.issue_status&.name %></strong></td>
          <td><%= issue.due_date ? format_date(issue.due_date) : '' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:label_no_pending_approval) %></p>
<% end %>

<h3><%= l(:label_pending_extension_plural) %></h3>

<% if @extensions.any? %>
  <table class="list issues">
    <thead>
      <tr>
        <th>#</th>
        <th><%= l(:label_project) %></th>
        <th><%= l(:field_subject) %></th>
        <th><%= l(:label_approval_step) %></th>
        <th><%= l(:label_extension_from_to) %></th>
        <th><%= l(:label_extension_reason) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @extensions.each do |extension| %>
        <% issue = extension.issue %>
        <% step = extension.current_approval_step %>
        <tr class="issue">
          <td><%= link_to issue.id, issue_path(issue) %></td>
          <td><%= link_to_project issue.project %></td>
          <td><%= link_to issue.subject, issue_path(issue) %></td>
          <td>
            <%= h step&.name %>
            <span class="approval-button-label">[<%= h(step&.action_label) %>]</span>
          </td>
          <td>
            <%= extension.previous_due_date ? format_date(extension.previous_due_date) : l(:label_none) %>
            &rarr; <strong><%= format_date extension.new_due_date %></strong>
          </td>
          <td><%= h extension.reason %></td>
          <td class="buttons">
            <%= button_to extension.approval_action_label,
                          approve_issue_issue_extension_path(issue, extension),
                          :method => :post,
                          :data => {:confirm => l(:text_confirm_extension_approve,
                                                  :date => format_date(extension.new_due_date))} %>
            <%= button_to l(:button_reject_extension),
                          reject_issue_issue_extension_path(issue, extension),
                          :method => :post,
                          :data => {:confirm => l(:text_are_you_sure)} %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:label_no_pending_extension) %></p>
<% end %>
