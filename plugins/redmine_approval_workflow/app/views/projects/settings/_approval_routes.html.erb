<div class="contextual">
  <%= link_to sprite_icon('add', l(:label_approval_route_new)),
              new_project_approval_route_path(@project), :class => 'icon icon-add' %>
  <%= link_to sprite_icon('add', l(:label_extension_route_new)),
              new_project_approval_route_path(@project, :kind => ApprovalRoute::EXTENSION_KIND),
              :class => 'icon icon-add' %>
</div>

<p class="info"><%= l(:text_project_approval_routes_hint) %></p>

<% all_routes = @project.approval_routes.includes(:trackers, :steps => [:issue_status, {:approvers => [:approver_role, :approver_user]}]) %>
<% routes = all_routes.reject(&:extension?) %>
<% extension_routes = all_routes.select(&:extension?) %>
<% if routes.any? %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:field_name) %></th>
        <th><%= l(:label_tracker_plural) %></th>
        <th><%= l(:label_approval_step_plural) %></th>
        <th><%= l(:field_active) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% routes.each do |route| %>
        <tr>
          <td><%= link_to h(route.name), edit_project_approval_route_path(@project, route) %></td>
          <td><%= h route.tracker_names.join(', ') %></td>
          <td>
            <ol class="approval-route-summary">
              <% route.steps.each do |step| %>
                <li>
                  <strong><%= h step.name %></strong>
                  &rarr; <%= h step.issue_status&.name %>
                  <span class="approval-button-label">[<%= h step.action_label %>]</span>
                  <% if (approver = approval_step_approver_label(step)) %>
                    <span class="approval-assignee"><%= h approver %></span>
                  <% end %>
                  <% if step.assigns_signer? %>
                    <span class="approval-assign-badge"><%= l(:label_assign_signer) %></span>
                  <% end %>
                </li>
              <% end %>
            </ol>
          </td>
          <td><%= checked_image route.active %></td>
          <td class="buttons">
            <%= link_to l(:button_edit), edit_project_approval_route_path(@project, route), :class => 'icon icon-edit' %>
            <%= link_to l(:button_delete), project_approval_route_path(@project, route),
                        :data => {:confirm => l(:text_are_you_sure)},
                        :method => :delete, :class => 'icon icon-del' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>

<h3><%= l(:label_extension_route_plural) %></h3>
<p class="info"><%= l(:text_extension_route_hint) %></p>

<% if extension_routes.any? %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:field_name) %></th>
        <th><%= l(:label_tracker_plural) %></th>
        <th><%= l(:label_approval_step_plural) %></th>
        <th><%= l(:field_active) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% extension_routes.each do |route| %>
        <tr>
          <td><%= link_to h(route.name), edit_project_approval_route_path(@project, route) %></td>
          <td><%= h route.tracker_names.join(', ') %></td>
          <td>
            <ol class="approval-route-summary">
              <% route.steps.each do |step| %>
                <li>
                  <strong><%= h step.name %></strong>
                  <span class="approval-button-label">[<%= h step.action_label %>]</span>
                  <% if (approver = approval_step_approver_label(step)) %>
                    <span class="approval-assignee"><%= h approver %></span>
                  <% end %>
                </li>
              <% end %>
            </ol>
          </td>
          <td><%= checked_image route.active %></td>
          <td class="buttons">
            <%= link_to l(:button_edit), edit_project_approval_route_path(@project, route), :class => 'icon icon-edit' %>
            <%= link_to l(:button_delete), project_approval_route_path(@project, route),
                        :data => {:confirm => l(:text_are_you_sure)},
                        :method => :delete, :class => 'icon icon-del' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
